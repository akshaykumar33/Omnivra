# Dependencies
node_modules/
.pnpm-store/

# Build & Dist Outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Turbo
.turbo/

# Environment variables
.env
.env.local
.env.*.local
!.env.example
!.env.sample
!.env.template

# Credentials & key material — never commit these.
# The protection gate blocks them too (scripts/check-sensitive-paths.mjs);
# this list is the first layer so they never reach `git add` in the first place.
*.pem
*.key
*.p8
*.p12
*.pfx
*.keystore
*.jks
*.ppk
*.asc
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.mobileprovision
credentials.json
secrets.json
secrets.yaml
secrets.yml
service-account*.json
gcp-*.json
aws-*.json
.aws/
.ssh/

# Captured media & user data — Omnivra touches cameras and microphones.
# Test fixtures must be synthetic and live under a fixtures/ directory.
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.wav
*.mp3
*.m4a
*.flac
*.ogg
!docs/assets/**
!**/fixtures/**

# Model weights — fetch at build time, do not commit.
*.onnx
*.tflite
*.safetensors
*.gguf
*.pt
*.pth

# Local databases & dumps
*.sqlite
*.sqlite3
*.db
*.dump

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# OS and Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Runtime
scratch/
tmp/
temp/
