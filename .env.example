# Omnivra — environment template
#
# Copy to `.env` and fill in locally. `.env` is git-ignored and the protection
# gate refuses to stage it. Never put a real value in this file.
#
#   cp .env.example .env
#
# Every key Omnivra reads must appear here with an empty or placeholder value,
# so a new contributor can see what the app needs without guessing.
# See docs/security/secret-management.md.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
OMNIVRA_LOG_LEVEL=debug

# --- AI providers ----------------------------------------------------------
# Omnivra is provider-independent (ADR 0007). Configure only what you use.
# Leave blank to disable a provider entirely.
OMNIVRA_AI_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local inference endpoints — no credentials required.
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# --- Cloud sync (optional; Omnivra is local-first per ADR 0008) -------------
OMNIVRA_CLOUD_ENABLED=false
OMNIVRA_API_BASE_URL=http://localhost:3000
DATABASE_URL=
REDIS_URL=
OMNIVRA_JWT_SECRET=

# --- Telemetry (opt-in only) -----------------------------------------------
OMNIVRA_TELEMETRY_ENABLED=false
OMNIVRA_TELEMETRY_ENDPOINT=

# --- Release / publishing --------------------------------------------------
# CI-only. These must come from GitHub Actions secrets, never from a local .env
# that could be staged by accident.
NPM_TOKEN=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
VSCE_PAT=
OVSX_PAT=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
