{
  "name": "omnivra-monorepo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Omnivra: Universal Multimodal Human-Computer Interaction Platform",
  "license": "Apache-2.0",
  "author": "Omnivra Contributors",
  "homepage": "https://github.com/akshaykumar33/Omnivra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshaykumar33/Omnivra.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "hooks:install": "node scripts/install-hooks.mjs",
    "gate": "pnpm gate:paths && pnpm gate:secrets && pnpm gate:hygiene && pnpm gate:branch",
    "gate:paths": "node scripts/check-sensitive-paths.mjs --all",
    "gate:secrets": "node scripts/scan-secrets.mjs --all",
    "gate:hygiene": "node scripts/check-forbidden-patterns.mjs --all",
    "gate:branch": "node scripts/check-branch-name.mjs",
    "gate:staged": "node scripts/check-sensitive-paths.mjs --staged && node scripts/scan-secrets.mjs --staged && node scripts/check-forbidden-patterns.mjs --staged",
    "gate:selftest": "node scripts/selftest-protection.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@types/node": "^24.0.0",
    "prettier": "3.9.9",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  }
}
